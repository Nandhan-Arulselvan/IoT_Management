<% String activePage = (String) request.getAttribute("activePage"); if (activePage == null) activePage = ""; String signedInUser = (String) session.getAttribute("authenticatedUserName"); String navigationToken = (String) request.getAttribute("csrfToken"); %>
<nav class="nav">
  <a<%= "dashboard".equals(activePage) ? " class=\"active\"" : "" %> href="<%= cp %>/dashboard">Dashboard</a>
  <a<%= "devices".equals(activePage) ? " class=\"active\"" : "" %> href="<%= cp %>/devices">Devices</a>
  <a<%= "sensors".equals(activePage) ? " class=\"active\"" : "" %> href="<%= cp %>/sensors">Sensors</a>
  <a<%= "readings".equals(activePage) ? " class=\"active\"" : "" %> href="<%= cp %>/readings">Readings</a>
</nav>
<div class="nav-footer">
  <span>Signed in as <strong><%= org.apache.commons.text.StringEscapeUtils.escapeHtml4(signedInUser == null ? "User" : signedInUser) %></strong></span>
  <form method="post" action="<%= cp %>/logout"><input type="hidden" name="csrfToken" value="<%= org.apache.commons.text.StringEscapeUtils.escapeHtml4(navigationToken) %>"><button class="text-button" type="submit">Log out</button></form>
</div>
<style>.sidebar{position:relative}.nav-footer{position:absolute;bottom:25px;left:28px;right:28px;color:var(--muted);font-size:12px}.nav-footer strong{display:block;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin:2px 0 8px}.nav-footer form{margin:0}@media(max-width:800px){.sidebar{position:fixed}}</style>
