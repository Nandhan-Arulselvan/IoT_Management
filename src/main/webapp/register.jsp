<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="org.apache.commons.text.StringEscapeUtils" %>
<% String cp = request.getContextPath(), token = (String) request.getAttribute("csrfToken"), flash = (String) request.getAttribute("flashMessage"), flashType = (String) request.getAttribute("flashType"); %>
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account · PulseGrid</title><link rel="stylesheet" href="<%= cp %>/assets/styles.css"><link rel="stylesheet" href="<%= cp %>/assets/auth.css"></head>
<body class="auth-page"><main class="auth-shell"><section class="auth-card"><div class="brand auth-brand"><span class="brand-mark">⌁</span> PulseGrid</div><div class="eyebrow">Create account</div><h1>Join PulseGrid</h1><p>Create your secure account to access the IoT management system.</p>
<% if (flash != null) { %><div class="alert <%= StringEscapeUtils.escapeHtml4(flashType) %>"><%= StringEscapeUtils.escapeHtml4(flash) %></div><% } %>
<form method="post" action="<%= cp %>/register" class="auth-form"><input type="hidden" name="csrfToken" value="<%= StringEscapeUtils.escapeHtml4(token) %>"><div><label for="username">Username</label><input id="username" required minlength="3" maxlength="50" pattern="[A-Za-z0-9._-]+" name="username" autocomplete="username" autofocus></div><div><label for="email">Email</label><input id="email" required type="email" maxlength="100" name="email" autocomplete="email"></div><div><label for="location">Location <span class="reading-note">optional</span></label><input id="location" maxlength="50" name="location" autocomplete="address-level2"></div><div><label for="password">Password</label><input id="password" required type="password" minlength="8" maxlength="72" name="password" autocomplete="new-password"></div><div><label for="confirmPassword">Confirm password</label><input id="confirmPassword" required type="password" minlength="8" maxlength="72" name="confirmPassword" autocomplete="new-password"></div><button class="button" type="submit">Create account</button></form><p class="auth-switch">Already have an account? <a href="<%= cp %>/login">Sign in</a></p></section></main></body></html>
