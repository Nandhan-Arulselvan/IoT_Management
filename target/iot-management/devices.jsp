<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="java.util.List" %>
<%@ page import="org.apache.commons.text.StringEscapeUtils" %>
<%
String cp = request.getContextPath(), search = (String) request.getAttribute("search"), selectedStatus = (String) request.getAttribute("selectedStatus"), selectedType = (String) request.getAttribute("selectedType"), sort = (String) request.getAttribute("sort"), token = (String) request.getAttribute("csrfToken"), error = (String) request.getAttribute("dbError"), flash = (String) request.getAttribute("flashMessage"), flashType = (String) request.getAttribute("flashType");
List<String[]> devices = (List<String[]>) request.getAttribute("devices"); List<String> types = (List<String>) request.getAttribute("types");
%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PulseGrid · Devices</title><link rel="stylesheet" href="<%=cp%>/assets/styles.css"></head>
<body><div class="layout"><aside class="sidebar"><div class="brand"><span class="brand-mark">⌁</span> PulseGrid</div><%@ include file="/WEB-INF/jspf/navigation.jspf" %></aside><main class="main">
<div class="page-head"><div><button class="button ghost nav-toggle" data-nav-toggle>Menu</button><div class="eyebrow">Inventory</div><h1>Device management</h1><p>Manage devices in your own IoT inventory.</p></div></div>
<%if(flash!=null){%><div class="alert <%=StringEscapeUtils.escapeHtml4(flashType)%>"><%=StringEscapeUtils.escapeHtml4(flash)%></div><%}%><%if(error!=null){%><div class="alert error"><%=StringEscapeUtils.escapeHtml4(error)%></div><%}%>
<section class="form-card"><div class="panel-title"><h2>Add device</h2><span class="reading-note">New devices are assigned to your account.</span></div><form method="post" action="<%=cp%>/devices" class="form-grid"><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="create"><div><label>Device name</label><input required maxlength="50" name="deviceName" placeholder="e.g. Warehouse monitor"></div><div><label>Device type</label><input maxlength="30" name="deviceType" list="device-types" placeholder="e.g. Sensor Hub"><datalist id="device-types"><%for(String t:types){%><option value="<%=StringEscapeUtils.escapeHtml4(t)%>"><%}%></datalist></div><div><label>Status</label><select required name="status"><option value="ACTIVE">Active</option><option value="INACTIVE">Inactive</option></select></div><div class="wide"><button class="button">Add Device</button></div></form></section>
<section class="panel"><div class="panel-title"><h2>Your devices</h2><span class="reading-note"><%=devices==null?0:devices.size()%> matching record(s)</span></div><form class="filters top-form" method="get" action="<%=cp%>/devices"><div><label>Search name</label><input name="search" value="<%=StringEscapeUtils.escapeHtml4(search)%>" placeholder="Find a device"></div><div><label>Status</label><select name="status"><option value="">All statuses</option><option value="ACTIVE" <%="ACTIVE".equalsIgnoreCase(selectedStatus)?"selected":""%>>Active</option><option value="INACTIVE" <%="INACTIVE".equalsIgnoreCase(selectedStatus)?"selected":""%>>Inactive</option></select></div><div><label>Device type</label><select name="type"><option value="">All types</option><%for(String t:types){%><option value="<%=StringEscapeUtils.escapeHtml4(t)%>" <%=t.equals(selectedType)?"selected":""%>><%=StringEscapeUtils.escapeHtml4(t)%></option><%}%></select></div><div><label>Sort by</label><select name="sort"><option value="id" <%="id".equals(sort)?"selected":""%>>ID</option><option value="name" <%="name".equals(sort)?"selected":""%>>Name</option><option value="type" <%="type".equals(sort)?"selected":""%>>Type</option><option value="status" <%="status".equals(sort)?"selected":""%>>Status</option></select></div><div><button class="button">Apply filters</button></div></form><div class="table-wrap"><table><thead><tr><th>ID</th><th>Device</th><th>Type</th><th>Status</th><th>Actions</th></tr></thead><tbody><%if(devices!=null&&!devices.isEmpty()){for(String[] d:devices){String id=StringEscapeUtils.escapeHtml4(d[0]);String status=d[4]==null?"ACTIVE":d[4];%><tr><td><%=id%></td><td><%=StringEscapeUtils.escapeHtml4(d[1])%></td><td><%=StringEscapeUtils.escapeHtml4(d[3]==null?"—":d[3])%></td><td><span class="badge <%=status.equalsIgnoreCase("ACTIVE")?"":"warn"%>"><%=StringEscapeUtils.escapeHtml4(status)%></span></td><td><div class="actions"><button type="button" class="text-button" data-edit="edit-<%=id%>">Edit</button><form class="inline-form" method="post" action="<%=cp%>/devices" data-confirm="Delete this device and all of its sensors and historical readings? This cannot be undone."><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="delete"><input type="hidden" name="deviceId" value="<%=id%>"><button class="text-button" style="color:var(--red)">Delete</button></form></div></td></tr><tr class="edit-row" id="edit-<%=id%>"><td colspan="5"><form method="post" action="<%=cp%>/devices" class="edit-grid"><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="update"><input type="hidden" name="deviceId" value="<%=id%>"><div><label>Name</label><input required maxlength="50" name="deviceName" value="<%=StringEscapeUtils.escapeHtml4(d[1])%>"></div><div><label>Type</label><input maxlength="30" name="deviceType" value="<%=StringEscapeUtils.escapeHtml4(d[3]==null?"":d[3])%>"></div><div><label>Status</label><select required name="status"><option value="ACTIVE" <%=status.equalsIgnoreCase("ACTIVE")?"selected":""%>>Active</option><option value="INACTIVE" <%=status.equalsIgnoreCase("INACTIVE")?"selected":""%>>Inactive</option></select></div><div><button class="button">Save changes</button></div></form></td></tr><%}}else{%><tr><td colspan="5" class="empty">No devices match these filters.</td></tr><%}%></tbody></table></div></section></main></div><script src="<%=cp%>/assets/app.js"></script></body></html>
