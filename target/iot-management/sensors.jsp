<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.List" %><%@ page import="org.apache.commons.text.StringEscapeUtils" %>
<%String cp=request.getContextPath(),search=(String)request.getAttribute("search"),selected=(String)request.getAttribute("selectedDevice"),token=(String)request.getAttribute("csrfToken"),error=(String)request.getAttribute("dbError"),flash=(String)request.getAttribute("flashMessage"),flashType=(String)request.getAttribute("flashType");List<String[]> sensors=(List<String[]>)request.getAttribute("sensors"),devices=(List<String[]>)request.getAttribute("devices");%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PulseGrid · Sensors</title><link rel="stylesheet" href="<%=cp%>/assets/styles.css"></head><body><div class="layout"><aside class="sidebar"><div class="brand"><span class="brand-mark">⌁</span> PulseGrid</div><%@ include file="/WEB-INF/jspf/navigation.jspf" %></aside><main class="main"><div class="page-head"><div><button class="button ghost nav-toggle" data-nav-toggle>Menu</button><div class="eyebrow">Instrumentation</div><h1>Sensor management</h1><p>Configure the sensors that belong to your device inventory.</p></div></div><%if(flash!=null){%><div class="alert <%=StringEscapeUtils.escapeHtml4(flashType)%>"><%=StringEscapeUtils.escapeHtml4(flash)%></div><%}%><%if(error!=null){%><div class="alert error"><%=StringEscapeUtils.escapeHtml4(error)%></div><%}%><section class="form-card"><div class="panel-title"><h2>Add a sensor</h2><span class="reading-note">IDs follow the existing S### format.</span></div><form method="post" action="<%=cp%>/sensors" class="form-grid"><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="create"><div><label>Sensor name</label><input required maxlength="50" name="sensorName" placeholder="e.g. Air quality"></div><div><label>Device</label><select required name="deviceId"><option value="">Select device</option><%for(String[] d:devices){%><option value="<%=StringEscapeUtils.escapeHtml4(d[0])%>"><%=StringEscapeUtils.escapeHtml4(d[1])%></option><%}%></select></div><div><label>Sensor type</label><input required maxlength="30" name="sensorType" placeholder="e.g. Temperature"></div><div><label>Unit</label><input maxlength="20" name="unit" placeholder="e.g. Celsius"></div><div class="wide"><button class="button">Add sensor</button></div></form></section><section class="panel"><div class="panel-title"><h2>Registered sensors</h2><span class="reading-note"><%=sensors==null?0:sensors.size()%> matching record(s)</span></div><form class="filters top-form" method="get" action="<%=cp%>/sensors"><div><label>Search</label><input name="search" value="<%=StringEscapeUtils.escapeHtml4(search)%>" placeholder="Name or type"></div><div><label>Device</label><select name="device"><option value="">All devices</option><%for(String[] d:devices){%><option value="<%=StringEscapeUtils.escapeHtml4(d[0])%>" <%=d[0].equals(selected)?"selected":""%>><%=StringEscapeUtils.escapeHtml4(d[1])%></option><%}%></select></div><div><button class="button">Apply filters</button></div></form><div class="table-wrap"><table><thead><tr><th>ID</th><th>Sensor</th><th>Device</th><th>Type</th><th>Unit</th><th>Actions</th></tr></thead><tbody><%if(sensors!=null&&!sensors.isEmpty()){for(String[] s:sensors){String id=StringEscapeUtils.escapeHtml4(s[0]);%><tr><td><%=id%></td><td><%=StringEscapeUtils.escapeHtml4(s[1])%></td><td><%=StringEscapeUtils.escapeHtml4(s[5])%></td><td><%=StringEscapeUtils.escapeHtml4(s[3])%></td><td><%=StringEscapeUtils.escapeHtml4(s[4]==null?"—":s[4])%></td><td><div class="actions"><button type="button" class="text-button" data-edit="edit-<%=id%>">Edit</button><form class="inline-form" method="post" action="<%=cp%>/sensors" data-confirm="Delete this sensor and all of its historical readings? This cannot be undone."><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="delete"><input type="hidden" name="sensorId" value="<%=id%>"><button class="text-button" style="color:var(--red)">Delete</button></form></div></td></tr><tr class="edit-row" id="edit-<%=id%>"><td colspan="6"><form method="post" action="<%=cp%>/sensors" class="edit-grid"><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="update"><input type="hidden" name="sensorId" value="<%=id%>"><div><label>Name</label><input required maxlength="50" name="sensorName" value="<%=StringEscapeUtils.escapeHtml4(s[1])%>"></div><div><label>Device</label><select required name="deviceId"><%for(String[] d:devices){%><option value="<%=StringEscapeUtils.escapeHtml4(d[0])%>" <%=d[0].equals(s[2])?"selected":""%>><%=StringEscapeUtils.escapeHtml4(d[1])%></option><%}%></select></div><div><label>Type</label><input required maxlength="30" name="sensorType" value="<%=StringEscapeUtils.escapeHtml4(s[3])%>"></div><div><label>Unit</label><input maxlength="20" name="unit" value="<%=StringEscapeUtils.escapeHtml4(s[4]==null?"":s[4])%>"></div><div><button class="button">Save changes</button></div></form></td></tr><%}}else{%><tr><td colspan="6" class="empty">No sensors match these filters.</td></tr><%}%></tbody></table></div></section></main></div><script src="<%=cp%>/assets/app.js"></script></body></html>
