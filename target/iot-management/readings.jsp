<%@ page contentType="text/html;charset=UTF-8" %>
<%@ page import="java.util.List" %>
<%@ page import="org.apache.commons.text.StringEscapeUtils" %>
<%
String cp = request.getContextPath(), selected = (String) request.getAttribute("selectedSensor"), from = (String) request.getAttribute("from"), to = (String) request.getAttribute("to"), token = (String) request.getAttribute("csrfToken"), error = (String) request.getAttribute("dbError"), flash = (String) request.getAttribute("flashMessage"), flashType = (String) request.getAttribute("flashType");
List<String[]> readings = (List<String[]>) request.getAttribute("readings"), sensors = (List<String[]>) request.getAttribute("sensors");
%>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PulseGrid · Readings</title><link rel="stylesheet" href="<%=cp%>/assets/styles.css"></head>
<body><div class="layout"><aside class="sidebar"><div class="brand"><span class="brand-mark">⌁</span> PulseGrid</div><%@ include file="/WEB-INF/jspf/navigation.jspf" %></aside><main class="main"><div class="page-head"><div><button class="button ghost nav-toggle" data-nav-toggle>Menu</button><div class="eyebrow">Historical telemetry</div><h1>Sensor readings</h1><p>Manage stored historical measurements. This page does not imply a live hardware connection.</p></div></div>
<%if(flash!=null){%><div class="alert <%=StringEscapeUtils.escapeHtml4(flashType)%>"><%=StringEscapeUtils.escapeHtml4(flash)%></div><%}%><%if(error!=null){%><div class="alert error"><%=StringEscapeUtils.escapeHtml4(error)%></div><%}%>
<section class="form-card"><div class="panel-title"><h2>Add reading</h2><span class="reading-note">Choose an existing sensor and its recorded timestamp.</span></div><form method="post" action="<%=cp%>/readings" class="form-grid"><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="create"><div><label>Sensor</label><select required name="sensorId"><option value="">Select sensor</option><%for(String[] s:sensors){%><option value="<%=StringEscapeUtils.escapeHtml4(s[0])%>"><%=StringEscapeUtils.escapeHtml4(s[1])%> (<%=StringEscapeUtils.escapeHtml4(s[0])%>)</option><%}%></select></div><div><label>Reading value</label><input required type="number" step="any" name="readingValue" placeholder="e.g. 23.5"></div><div><label>Recorded at</label><input required type="datetime-local" name="readingTime"></div><div class="wide"><button class="button">Add Reading</button></div></form></section>
<section class="panel"><div class="panel-title"><h2>Reading history</h2><span class="reading-note">Newest first</span></div><form class="filters top-form" method="get" action="<%=cp%>/readings"><div><label>Sensor</label><select name="sensor"><option value="">All sensors</option><%for(String[] s:sensors){%><option value="<%=StringEscapeUtils.escapeHtml4(s[0])%>" <%=s[0].equals(selected)?"selected":""%>><%=StringEscapeUtils.escapeHtml4(s[1])%></option><%}%></select></div><div><label>From</label><input type="date" name="from" value="<%=StringEscapeUtils.escapeHtml4(from)%>"></div><div><label>To</label><input type="date" name="to" value="<%=StringEscapeUtils.escapeHtml4(to)%>"></div><div><button class="button">Apply filters</button></div></form><div class="table-wrap"><table><thead><tr><th>ID</th><th>Sensor</th><th>Device</th><th>Value</th><th>Unit</th><th>Recorded at</th><th>Actions</th></tr></thead><tbody><%if(readings!=null&&!readings.isEmpty()){for(String[] r:readings){String id=StringEscapeUtils.escapeHtml4(r[0]);%><tr><td><%=id%></td><td><%=StringEscapeUtils.escapeHtml4(r[2])%></td><td><%=StringEscapeUtils.escapeHtml4(r[3])%></td><td><%=StringEscapeUtils.escapeHtml4(r[4])%></td><td><%=StringEscapeUtils.escapeHtml4(r[5]==null?"—":r[5])%></td><td><%=StringEscapeUtils.escapeHtml4(r[6])%></td><td><div class="actions"><button type="button" class="text-button" data-edit="edit-<%=id%>">Edit</button><form class="inline-form" method="post" action="<%=cp%>/readings" data-confirm="Delete this historical reading? This cannot be undone."><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="delete"><input type="hidden" name="readingId" value="<%=id%>"><button class="text-button" style="color:var(--red)">Delete</button></form></div></td></tr><tr class="edit-row" id="edit-<%=id%>"><td colspan="7"><form method="post" action="<%=cp%>/readings" class="edit-grid"><input type="hidden" name="csrfToken" value="<%=StringEscapeUtils.escapeHtml4(token)%>"><input type="hidden" name="action" value="update"><input type="hidden" name="readingId" value="<%=id%>"><div><label>Sensor</label><select required name="sensorId"><%for(String[] s:sensors){%><option value="<%=StringEscapeUtils.escapeHtml4(s[0])%>" <%=s[0].equals(r[1])?"selected":""%>><%=StringEscapeUtils.escapeHtml4(s[1])%></option><%}%></select></div><div><label>Reading value</label><input required type="number" step="any" name="readingValue" value="<%=StringEscapeUtils.escapeHtml4(r[4])%>"></div><div><label>Recorded at</label><input required type="datetime-local" name="readingTime" value="<%=StringEscapeUtils.escapeHtml4(r[7])%>"></div><div><button class="button">Save changes</button></div></form></td></tr><%}}else{%><tr><td colspan="7" class="empty">No readings match these filters.</td></tr><%}%></tbody></table></div></section></main></div><script src="<%=cp%>/assets/app.js"></script></body></html>
